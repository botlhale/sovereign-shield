{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python -m pytest:*)",
      "Bash(.venv/bin/python -m pytest:*)",
      "Bash(python sh/verify_docs.py:*)",
      "Bash(.venv/bin/python sh/verify_docs.py:*)",
      "Bash(python evals/run_evals.py --self-test:*)",
      "Bash(terraform -chdir=terraform fmt:*)",
      "Bash(terraform -chdir=terraform validate:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.tfstate)",
      "Read(./**/*.tfstate.*)",
      "Read(~/.databrickscfg)",
      "Read(~/.azure/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|MultiEdit|Write|NotebookEdit|Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/pretool_gate.py\""
          }
        ]
      }
    ]
  }
}
