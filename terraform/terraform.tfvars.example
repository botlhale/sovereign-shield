# Copy to terraform.tfvars and fill in. Every value below is a location, a name
# or a toggle.
#
# There is deliberately no credential here, and no variable that could hold one:
# secrets are resolved from Key Vault at apply time or injected by the platform
# at run time. tests/test_secret_decoupling.py fails the build if a
# secret-shaped Terraform variable is ever declared, and asserts that no
# terraform.tfvars file is committed.

subscription_id = "c0642147-5434-45b4-a041-e90fc846be92"
tenant_id       = "f4f2ab4f-0397-41ab-a28a-5152e4a7afe9"

resource_group_name = "rg-sovereignshield"
location            = "canadacentral"

# Set to false when the resource group already exists - a landing zone owns it,
# or the sh/ quickstart created it before Terraform saw it. Terraform then reads
# the group instead of creating it, uses its region rather than `location`, and
# leaves it in place on destroy.
create_resource_group = true
workspace_name      = "dbw-sovereignshield"

catalog_name = "dbw_sovereignshield"
schema_name  = "sovereign_shield"

# Changing this requires fn_rls_multi_persona_lock and fn_ddm_obs_conf_mask
# to change in lockstep. A mismatch does not error - it fails closed.
group_prefix = "sg-sovereignshield"

# Adding a jurisdiction also needs a branch in the row filter and rows in the
# MVSD, or the new group resolves to zero rows.
reporting_jurisdictions = ["ca", "us"]

github_repository  = "botnt/sovereign-shield"
github_environment = "production"

sql_warehouse_size              = "2X-Small"
sql_warehouse_auto_stop_minutes = 10

# Concurrency lever for the public dissemination tier. Raise before raising
# size when the complaint is queueing rather than slow individual queries.
sql_warehouse_max_clusters = 1

# ---------------------------------------------------------------------------
# Ingestion compute envelope
#
# Defaults are the evaluation sandbox: driver-only, no worker fleet, no Photon.
# This is a cost choice, not an architectural limit - the row filter and column
# mask are evaluated by the engine and behave identically at any size.
#
# An international hub ingesting every member jurisdiction typically runs:
#   worker_count_min = 2
#   worker_count_max = 16
#   node_type_id     = "Standard_E8ds_v5"
#   enable_photon    = true
# ---------------------------------------------------------------------------
worker_count_min        = 0
worker_count_max        = 0
node_type_id            = "Standard_DS3_v2"
enable_photon           = false
autotermination_minutes = 20

# The only deployment that can demonstrate genuinely anonymous access.
deploy_dissemination_gateway = true
gateway_image                = "acrsovereignshield.azurecr.io/sovereignshield-portal:latest"

# Leave false on the first apply. Tables are created by the Asset Bundle, and a
# grant on a non-existent securable fails.
grant_tables = false
